# Supabase configuration
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Google OAuth credentials
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Database configuration (if needed by other edge functions)
DB_URL=your_supabase_project_url
DB_SERVICE_ROLE_KEY=your_supabase_service_role_key
DB_ANON_KEY=your_supabase_anon_key

# Instructions:
# 1. Copy this file to .env.deno
# 2. Replace the placeholder values with your actual credentials
# 3. Use start-local.sh to run edge functions locally with these environment variables